+"""Checkpoint loading and parameter-key coverage.
+
+Copyright 2026 The Sekai Authors.
+Distributed under the SAM License in LICENSE.
+"""
+
+from typing import Any
+
+from torch import nn
+
+
+def load_state_dict_with_report(
+    model: nn.Module,
+    state_dict: dict[str, Any],
+    *,
+    component: str,
+    require_exact: bool = False,
+) -> dict[str, Any]:
+    """Load state_dict into model and return parameter-key coverage.
+
+    require_exact raises RuntimeError for missing or unexpected keys.
+    """
+    if not isinstance(state_dict, dict) or not state_dict:
+        raise TypeError("checkpoint state_dict must be a populated dictionary")
+    model_keys = set(model.state_dict())
+    missing_keys, unexpected_keys = model.load_state_dict(
+        state_dict, strict=False
+    )
+    missing = sorted(str(value) for value in missing_keys)
+    unexpected = sorted(str(value) for value in unexpected_keys)
+    matched = len(model_keys.difference(missing_keys))
+    report = {
+        "component": component,
+        "model_key_count": len(model_keys),
+        "checkpoint_key_count": len(state_dict),
+        "matched_model_key_count": matched,
+        "model_key_coverage": matched / max(1, len(model_keys)),
+        "missing_key_count": len(missing),
+        "unexpected_key_count": len(unexpected),
+        "missing_keys": missing,
+        "unexpected_keys": unexpected,
+        "exact_key_match": not missing and not unexpected,
+    }
+    if require_exact and not report["exact_key_match"]:
+        raise RuntimeError(
+            f"{component} checkpoint key mismatch: "
+            f"missing={len(missing)} unexpected={len(unexpected)}"
+        )
+    return report
